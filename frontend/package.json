{
  "name": "lightweight-nginx-manager-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "package:server": "npm run build && node scripts/qa-contract.mjs && node scripts/package-release.mjs",
    "test": "npm run build && node scripts/qa-contract.mjs && node scripts/qa-certificate-config.mjs && node scripts/qa-operation-recovery.mjs && node scripts/qa-site-deployment-contract.mjs && node scripts/qa-site-operation-state.mjs && node scripts/qa-site-editor.mjs && node scripts/qa-site-detail-contract.mjs && node scripts/qa-template-dirty.mjs && node scripts/qa-live-logs.mjs && node scripts/qa-high-availability.mjs && node scripts/qa-lvs.mjs && node scripts/qa-ipvs-groups.mjs",
    "qa:certificate-config": "node scripts/qa-certificate-config.mjs",
    "qa:live-logs": "node scripts/qa-live-logs.mjs",
    "qa:visual": "npm run build && node scripts/qa-capture.mjs",
    "qa:high-availability": "npm run build && node scripts/qa-high-availability.mjs",
    "qa:lvs": "npm run build && node scripts/qa-lvs.mjs",
    "qa:site-editor": "npm run build && node scripts/qa-site-editor.mjs",
    "qa:site-deployment": "node scripts/qa-site-deployment-contract.mjs",
    "qa:site-operation-state": "node scripts/qa-site-operation-state.mjs",
    "qa:site-detail": "npm run build && node scripts/qa-site-detail-contract.mjs",
    "qa:template-dirty": "npm run build && node scripts/qa-template-dirty.mjs",
    "preview": "vite preview",
    "preview:qa": "node scripts/qa-server.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "gsap": "3.15.0",
    "@lucide/vue": "1.27.0",
    "naive-ui": "2.44.1",
    "pinia": "4.0.2",
    "three": "0.185.1",
    "vanta": "0.5.24",
    "vue": "3.5.40",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "@types/three": "0.185.1",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vite-plugin-singlefile": "2.3.3",
    "vue-tsc": "3.3.8"
  }
}
