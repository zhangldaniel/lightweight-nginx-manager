{
  "name": "lightweight-nginx-manager-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-font-css.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-font-css.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "package:server": "npm run build && node scripts/qa-contract.mjs && node scripts/package-release.mjs",
    "test": "npm run build && node scripts/qa-contract.mjs",
    "qa:visual": "npm run build && node scripts/qa-capture.mjs",
    "qa:site-editor": "npm run build && node scripts/qa-site-editor.mjs",
    "preview": "vite preview",
    "preview:qa": "node scripts/qa-server.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "gsap": "3.15.0",
    "@lucide/vue": "1.27.0",
    "naive-ui": "2.44.1",
    "pinia": "4.0.2",
    "three": "0.185.1",
    "vanta": "0.5.24",
    "vue": "3.5.40",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "@types/three": "0.185.1",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vite-plugin-singlefile": "2.3.3",
    "vue-tsc": "3.3.8"
  }
}
